# Backend Environment Variables

# MongoDB — primary cluster (dbIndex 0)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/al-hussein

# Optional failover clusters. Any sequential numeric suffix is detected automatically
# (no max). Writes are distributed via round-robin; on Atlas storage-quota errors they
# fall back to the next database. Reads merge all live connections.
# Add as many as needed (e.g., for 6 total databases: MONGODB_URI through MONGODB_URI_6)
# MONGODB_URI_2=mongodb+srv://user:password@cluster2.mongodb.net/al-hussein
# MONGODB_URI_3=mongodb+srv://user:password@cluster3.mongodb.net/al-hussein
# MONGODB_URI_4=mongodb+srv://user:password@cluster4.mongodb.net/al-hussein
# MONGODB_URI_5=mongodb+srv://user:password@cluster5.mongodb.net/al-hussein
# MONGODB_URI_6=mongodb+srv://user:password@cluster6.mongodb.net/al-hussein

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# Admin Credentials
# IMPORTANT: Use bcrypt hash instead of plaintext password
# Generate hash with: npx tsx scripts/generate-password-hash.ts
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$generatedBcryptHashHere

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# UploadThing — primary token (server-side only, not exposed to browser)
# Note: Multi-token round-robin distribution for UploadThing requires a different
# architectural approach than MongoDB since UploadThing creates a single instance
# per file router. For now, use a single primary token.
UPLOADTHING_TOKEN=sk_live_...

# Path A payment destinations shown at checkout (manual verification)
VODAFONE_CASH_NUMBER=010xxxxxxxx
INSTAPAY_HANDLE=010xxxxxxxx@instapay
BANK_ACCOUNT_DETAILS=حساب بنك مصر: 0123456789012345
